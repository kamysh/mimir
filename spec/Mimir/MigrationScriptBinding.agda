{-# OPTIONS --safe #-}
-- Bind the embedded SQL bodies to their application DDL contracts.
-- SQL whitespace is ignored only at the script boundary, as by the loader;
-- statements, constraints and constants within a body remain exact.
module Mimir.MigrationScriptBinding where

open import Data.List using (List; []; _∷_)
open import Data.String using (toList)
open import Relation.Binary.PropositionalEquality using (_≡_)
open import Mimir.Text using (Text; trim)
import Mimir.MigrationSchema as Schema
import Mimir.MigrationLedger as Ledger

source : Schema.Migration → Text
source Schema.initial = toList "-- Create the AGE graph if it doesn't already exist.\nSELECT ag_catalog.create_graph(current_database()::text)\nWHERE NOT EXISTS (\n    SELECT 1 FROM ag_catalog.ag_graph WHERE name = current_database()::text\n);\n\n-- Vertex labels\nDO $$ BEGIN PERFORM ag_catalog.create_vlabel(current_database()::text, 'Belief');        EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_vlabel(current_database()::text, 'Pattern');       EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_vlabel(current_database()::text, 'DocumentChunk'); EXCEPTION WHEN others THEN NULL; END $$;\n\n-- Edge labels\nDO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'SUPPORTS');    EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'DEFEATS');     EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'CAUSES');      EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'CONTRADICTS'); EXCEPTION WHEN others THEN NULL; END $$;\nDO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'CONTAINS');    EXCEPTION WHEN others THEN NULL; END $$;\n\n-- pgvector embeddings table (agtype cannot store the vector type)\nCREATE TABLE IF NOT EXISTS public.chunk_embeddings (\n    chunk_id  UUID PRIMARY KEY,\n    embedding vector\n);\n"
source Schema.searchPath = toList "DO $$ BEGIN\n  EXECUTE format(\n    'ALTER DATABASE %I SET search_path = ag_catalog, \"$user\", public',\n    current_database()\n  );\nEND $$;\n"
source Schema.embeddingTable = toList "CREATE TABLE IF NOT EXISTS public.belief_embeddings (\n    belief_id UUID PRIMARY KEY,\n    embedding vector\n);\n"
source Schema.evidenceEdges = toList "DO $$ BEGIN PERFORM ag_catalog.create_elabel(current_database()::text, 'GROUNDS'); EXCEPTION WHEN others THEN NULL; END $$;\n"
source Schema.betaBeliefs = toList "DO $mig$\nBEGIN\n  EXECUTE format($cy$\n    SELECT * FROM ag_catalog.cypher(%L, $$\n      MATCH (n:Belief)\n      WHERE n.alpha0 IS NULL\n      SET n.alpha0 = n.probability * (2.0 + n.confidence * 198.0),\n          n.beta0  = (1.0 - n.probability) * (2.0 + n.confidence * 198.0),\n          n.alpha  = n.probability * (2.0 + n.confidence * 198.0),\n          n.beta   = (1.0 - n.probability) * (2.0 + n.confidence * 198.0)\n      RETURN count(n)\n    $$) AS (c ag_catalog.agtype)\n  $cy$, current_database());\nEND\n$mig$;\n"
source Schema.learning = toList "CREATE TABLE mimir_experiences (\n    id uuid PRIMARY KEY,\n    project text NOT NULL,\n    revision bigint NOT NULL CHECK (revision > 0),\n    review_revision bigint NOT NULL DEFAULT 0,\n    reviewed_revision bigint NOT NULL DEFAULT 0,\n    updated_at timestamptz NOT NULL DEFAULT now()\n);\nCREATE TABLE mimir_experience_versions (\n    experience_id uuid NOT NULL REFERENCES mimir_experiences(id) ON DELETE CASCADE,\n    revision bigint NOT NULL,\n    payload jsonb NOT NULL,\n    created_at timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (experience_id, revision)\n);\nCREATE TABLE mimir_review_versions (\n    experience_id uuid NOT NULL REFERENCES mimir_experiences(id) ON DELETE CASCADE,\n    revision bigint NOT NULL,\n    experience_revision bigint NOT NULL,\n    payload jsonb NOT NULL,\n    created_at timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (experience_id, revision),\n    FOREIGN KEY (experience_id, experience_revision)\n      REFERENCES mimir_experience_versions(experience_id, revision)\n);\nCREATE INDEX mimir_pending_reviews ON mimir_experiences(updated_at, id)\n    WHERE reviewed_revision < revision;\n"
source Schema.candidates = toList "ALTER TABLE mimir_review_versions ADD COLUMN request jsonb;\nCREATE TABLE mimir_review_candidates (\n    experience_id uuid NOT NULL REFERENCES mimir_experiences(id) ON DELETE CASCADE,\n    candidate_key text NOT NULL CHECK (length(candidate_key) BETWEEN 1 AND 128),\n    kind text NOT NULL CHECK (kind IN ('belief', 'pattern')),\n    node_id uuid NOT NULL UNIQUE,\n    declaration jsonb NOT NULL,\n    retired boolean NOT NULL DEFAULT false,\n    PRIMARY KEY (experience_id, candidate_key)\n);\nCREATE INDEX mimir_review_candidates_node ON mimir_review_candidates(node_id);\n"
source Schema.assessment = toList "CREATE TABLE mimir_assessment_contributions (\n    experience_id uuid NOT NULL,\n    review_revision bigint NOT NULL,\n    belief_id uuid NOT NULL,\n    scope text NOT NULL,\n    rubric text NOT NULL,\n    positive double precision NOT NULL CHECK (positive BETWEEN 0 AND 1),\n    negative double precision NOT NULL CHECK (negative BETWEEN 0 AND 1),\n    benefit double precision NOT NULL CHECK (benefit BETWEEN -1 AND 1),\n    benefit_weight double precision NOT NULL CHECK (benefit_weight BETWEEN 0 AND 1),\n    payload jsonb NOT NULL,\n    PRIMARY KEY (experience_id,review_revision,belief_id,scope,rubric),\n    FOREIGN KEY (experience_id,review_revision)\n      REFERENCES mimir_review_versions(experience_id,revision) ON DELETE CASCADE,\n    CHECK (positive + negative <= 1.000000000000001),\n    CHECK (abs(benefit) <= benefit_weight)\n);\nCREATE INDEX mimir_assessment_lookup ON mimir_assessment_contributions(belief_id,scope,rubric);\n"
source Schema.owners = toList "CREATE TABLE mimir_learning_item_owners (\n    item_id uuid PRIMARY KEY,\n    experience_id uuid NOT NULL REFERENCES mimir_experiences(id) ON DELETE CASCADE,\n    source_ref text NOT NULL,\n    actor text NOT NULL\n);\n"

source Schema.allocation = toList "-- Historical UUIDs are imported, never regenerated. Existing ownership rows\n-- remain authoritative if an older history contains conflicting provenance.\nINSERT INTO mimir_learning_item_owners(item_id,experience_id,source_ref,actor)\nSELECT (item->>'id')::uuid, experience_id, item->>'source_ref', item->>'actor'\nFROM (\n    SELECT experience_id, jsonb_array_elements(COALESCE(payload->'learning_items','[]'::jsonb)) AS item\n    FROM mimir_experience_versions\n    UNION ALL\n    SELECT experience_id, jsonb_array_elements(COALESCE(payload->'extracted_items','[]'::jsonb)) AS item\n    FROM mimir_review_versions\n) AS historical\nON CONFLICT(item_id) DO NOTHING;\n\nALTER TABLE mimir_learning_item_owners\n    ALTER COLUMN item_id SET DEFAULT gen_random_uuid(),\n    ADD COLUMN item_key text,\n    ADD CONSTRAINT mimir_learning_item_local_key UNIQUE(experience_id,item_key),\n    ADD CONSTRAINT mimir_learning_item_key_nonempty CHECK(item_key IS NULL OR length(btrim(item_key)) > 0);\n"

source Schema.reviewQueueNotifications = toList "CREATE FUNCTION public.mimir_notify_review_queue() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    IF NEW.reviewed_revision < NEW.revision THEN\n        IF TG_OP = 'INSERT' THEN\n            PERFORM pg_notify('mimir_review_queue_changed', '');\n        ELSIF OLD.revision IS DISTINCT FROM NEW.revision\n           OR OLD.project IS DISTINCT FROM NEW.project\n           OR OLD.reviewed_revision >= OLD.revision THEN\n            PERFORM pg_notify('mimir_review_queue_changed', '');\n        END IF;\n    END IF;\n    RETURN NEW;\nEND;\n$$;\n\n-- PostgreSQL publishes transactional notifications at commit and discards them\n-- on rollback. Identical notifications may be coalesced within a transaction:\n-- a listener must scan the queue rather than count signals or treat one as a\n-- saved review receipt. Updates that only acknowledge a review do not wake it.\nCREATE TRIGGER mimir_review_queue_changed\nAFTER INSERT OR UPDATE OF revision, reviewed_revision, project\nON public.mimir_experiences\nFOR EACH ROW EXECUTE FUNCTION public.mimir_notify_review_queue();\n"

source Schema.operationReservations = toList "CREATE TABLE mimir_operation_reservations (\n    operation_token uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    reserved_at timestamptz NOT NULL DEFAULT now()\n);\n"

source Schema.operationBindings = toList "CREATE TABLE mimir_operation_bindings (\n    operation_token uuid PRIMARY KEY REFERENCES mimir_operation_reservations(operation_token),\n    operation text NOT NULL CHECK (operation <> '' AND operation = btrim(operation)),\n    arguments jsonb NOT NULL CHECK (jsonb_typeof(arguments) = 'object'),\n    settings jsonb NOT NULL CHECK (jsonb_typeof(settings) = 'object'),\n    bound_at timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE FUNCTION mimir_preserve_operation_binding() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    RAISE EXCEPTION 'Operation binding is immutable; read the existing binding and retry its original request'\n        USING ERRCODE = '23514';\nEND;\n$$;\n\nCREATE TRIGGER mimir_operation_binding_immutable\nBEFORE UPDATE OR DELETE ON mimir_operation_bindings\nFOR EACH ROW EXECUTE FUNCTION mimir_preserve_operation_binding();\n"

source Schema.operationStepReplies = toList "CREATE TABLE mimir_operation_step_replies (\n    operation_token uuid NOT NULL REFERENCES mimir_operation_bindings(operation_token),\n    step text NOT NULL CHECK (step <> '' AND step = btrim(step)),\n    reply jsonb NOT NULL,\n    PRIMARY KEY (operation_token, step)\n);\n\nCREATE FUNCTION mimir_preserve_operation_step_reply() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    RAISE EXCEPTION 'Step reply is immutable; read the original answer under this token and step'\n        USING ERRCODE = '23514';\nEND;\n$$;\n\nCREATE TRIGGER mimir_operation_step_reply_immutable\nBEFORE UPDATE OR DELETE ON mimir_operation_step_replies\nFOR EACH ROW EXECUTE FUNCTION mimir_preserve_operation_step_reply();\n"

source Schema.operationPlans = toList "CREATE TABLE mimir_operation_plans (\n    operation_token uuid PRIMARY KEY REFERENCES mimir_operation_bindings(operation_token),\n    plan jsonb NOT NULL CHECK (jsonb_typeof(plan) = 'object')\n);\n\nCREATE FUNCTION mimir_preserve_operation_plan() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    RAISE EXCEPTION 'Operation plan is immutable; read the original plan and saved answers'\n        USING ERRCODE = '23514';\nEND;\n$$;\n\nCREATE TRIGGER mimir_operation_plan_immutable\nBEFORE UPDATE OR DELETE ON mimir_operation_plans\nFOR EACH ROW EXECUTE FUNCTION mimir_preserve_operation_plan();\n"

source Schema.operationRequestKeys = toList "CREATE TABLE mimir_operation_request_keys (\n    request_key text PRIMARY KEY CHECK (length(btrim(request_key)) > 0),\n    operation_token uuid NOT NULL UNIQUE REFERENCES mimir_operation_reservations(operation_token)\n);\n\nCREATE FUNCTION mimir_preserve_operation_request_key() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    RAISE EXCEPTION 'Request key is immutable; repeat the original key to recover its reservation'\n        USING ERRCODE = '23514';\nEND;\n$$;\n\nCREATE TRIGGER mimir_operation_request_key_immutable\nBEFORE UPDATE OR DELETE ON mimir_operation_request_keys\nFOR EACH ROW EXECUTE FUNCTION mimir_preserve_operation_request_key();\n\nCREATE FUNCTION mimir_preserve_keyed_reservation() RETURNS trigger\nLANGUAGE plpgsql AS $$\nBEGIN\n    IF EXISTS (SELECT 1 FROM mimir_operation_request_keys WHERE operation_token = OLD.operation_token) THEN\n        RAISE EXCEPTION 'Reservation is immutable; repeat its request key to recover the original token and time'\n            USING ERRCODE = '23514';\n    END IF;\n    IF TG_OP = 'DELETE' THEN\n        RETURN OLD;\n    END IF;\n    RETURN NEW;\nEND;\n$$;\n\nCREATE TRIGGER mimir_keyed_reservation_immutable\nBEFORE UPDATE OR DELETE ON mimir_operation_reservations\nFOR EACH ROW EXECUTE FUNCTION mimir_preserve_keyed_reservation();\n"

source Schema.candidateKeyContent = toList "ALTER TABLE mimir_review_candidates\n    DROP CONSTRAINT mimir_review_candidates_candidate_key_check,\n    ADD CONSTRAINT mimir_review_candidates_candidate_key_nonempty\n        CHECK (length(candidate_key) > 0);\n"

data Statement : Set where
  application : Schema.DDL → Statement
  transactionSearchPath : List Text → Statement
  dropLegacyLedger : Statement

data Meaning (original : Text) : List Statement → Set where
  embedded : ∀ migration → trim original ≡ trim (source migration) →
    Meaning original (Data.List.map application (Schema.body migration))
  localPath : trim original ≡ toList "SET LOCAL search_path TO public,ag_catalog" →
    Meaning original (transactionSearchPath (toList "public" ∷ toList "ag_catalog" ∷ []) ∷ [])
  legacyDrop : trim original ≡ toList "DROP TABLE IF EXISTS _sqlx_migrations" →
    Meaning original (dropLegacyLedger ∷ [])

record Embedded (migration : Schema.Migration) (loaded : Ledger.Migration) : Set where
  field named : Ledger.Migration.name loaded ≡ toList (Schema.migrationName migration)
        body : trim (Ledger.Metadata.script (Ledger.Migration.payload loaded)) ≡ trim (source migration)

-- This receipt connects executeOriginalSQL/executeScript to the exact loaded
-- body, while MigrationRuntime retains transaction/lock/checksum/ledger order.
meaning : ∀ migration loaded → Embedded migration loaded →
  Meaning (Ledger.Metadata.script (Ledger.Migration.payload loaded))
    (Data.List.map application (Schema.body migration))
meaning migration loaded loadedSource = embedded migration (Embedded.body loadedSource)
