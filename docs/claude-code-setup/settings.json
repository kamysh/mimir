{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'mcp__mimir tools are available. Invoke the mimir skill now: load the read+write belief-graph protocol (consult before >2-step exploration, errors, or approach choices; write back what recurs).'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mimir hook prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(jq -r .session_id 2>/dev/null); rm -f \"/tmp/claude-mm-mimir-$sid\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__mimir__query_relevant|mcp__mimir__query_document",
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(jq -r .session_id 2>/dev/null); touch \"/tmp/claude-mm-mimir-$sid\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE '\\bgit\\b|\\bgh\\b'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"ask\",permissionDecisionReason:\"git/gh operation — explicit approval required\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mimir hook pretooluse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mimir hook stop"
          }
        ]
      }
    ]
  }
}
